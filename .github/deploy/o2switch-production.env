# Non-sensitive production deployment settings.
# Secrets stay in GitHub Actions secrets. See .github/deploy/README.md.

ALLOWED_ACTOR="mattrbdr"
DEPLOY_BRANCH="main"
NODE_VERSION="24"

INSTALL_COMMAND="npm ci"
CHECK_COMMANDS="npm run lint && npm run typecheck"
BUILD_COMMAND="npm run generate"
BUILD_OUTPUT=".output/public"

# Remote paths are relative to the O2Switch/cPanel home directory.
REMOTE_PATH="public_html/"
BACKUP_PATH="backups/"
KEEP_BACKUPS="5"
